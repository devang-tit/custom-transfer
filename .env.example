# PostgreSQL connection string (on Vercel this comes from the Postgres integration)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inkforge?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Razorpay (UPI, cards, netbanking, wallets). Leave empty to use the demo payment.
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys until you go live.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks: URL https://<your-site>/api/razorpay/webhook,
# events payment.captured, order.paid, payment.failed; paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=""

# Email (order notifications). Leave SMTP_HOST empty to save emails to storage/emails
# and the Admin → Email log instead of sending them (dev outbox).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"   # "true" for port 465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="InkForge <orders@your-domain.com>"

# Vercel Blob storage for customer uploads (required on Vercel; set automatically when a Blob store is connected).
# Leave empty locally to store uploads in storage/uploads.
BLOB_READ_WRITE_TOKEN=""

# Seeding a remote database (e.g. first Vercel deploy) requires an admin password; demo passwords are local-only.
SEED_ADMIN_PASSWORD=""
