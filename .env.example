# Email (order notifications). Leave SMTP_HOST empty to save emails to storage/emails
# and the Admin → Email log instead of sending them (dev outbox).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"   # "true" for port 465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="InkForge <orders@your-domain.com>"
